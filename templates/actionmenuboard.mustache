{{!
    @template mod_kanban/actionmenuboard

    Template for the action menu for boards.

    Example context (json):
    {
        "cmid": 130,
        "id": 4,
        "locked": false,
        "hastemplate": false,
        "showactionmenu": true,
        "manageboard": false,
        "groupmode": 2,
        "userboards": 1,
        "ismyuserboard": false,
        "viewallboards": true,
        "groupselector": "",
        "users": [
            {"id": 1, "fullname": "Berti Beispiel"}
        ]
    }
}}
{{#showactionmenu}}
<button class="mod_kanban_action_menu_trigger mod_kanban_board_actions_button btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-toggle="dropdown">
    <span class="mod_kanban_board_actions_icon">{{#pix}} i/settings, core, {{#str}} boardactions, mod_kanban {{/str}} {{/pix}}</span>
    <span class="mod_kanban_board_actions_label">{{#str}} boardactions, mod_kanban {{/str}}</span>
</button>
<ul class="dropdown-menu dropdown-menu-left">
    {{#manageboard}}
    {{#boardmode}}
    <li class="nav-item mod_kanban_save_board_as_template">
        <a class="dropdown-item" data-action="save_board_as_template" data-id="{{id}}">
            <i class="icon fa-solid fa-bookmark fa-fw" aria-hidden="true"></i>{{#str}} saveastemplate, mod_kanban {{/str}}
        </a>
    </li>
    <li class="nav-item mod_kanban_apply_template_to_board">
        <a class="dropdown-item" data-action="apply_template_to_board" data-id="{{id}}">
            <i class="icon fa-solid fa-paste fa-fw" aria-hidden="true"></i>{{#str}} applytemplatetothisboard, mod_kanban {{/str}}
        </a>
    </li>
    <li class="nav-item mod_kanban_apply_template_to_all_group_boards">
        <a class="dropdown-item" data-action="apply_template_to_all_group_boards" data-id="{{id}}">
            <i class="icon fa-solid fa-layer-group fa-fw" aria-hidden="true"></i>{{#str}} applytemplatetoallgroupboards, mod_kanban {{/str}}
        </a>
    </li>
    {{/boardmode}}
    <li class="nav-item mod_kanban_lock_board_columns">
        <a class="dropdown-item" data-action="lock_board_columns" data-id="{{id}}">{{#pix}} t/lock, core, {{#str}} lockboardcolumns, mod_kanban {{/str}} {{/pix}}{{#str}} lockboardcolumns, mod_kanban {{/str}}</a>
    </li>
    <li class="nav-item mod_kanban_unlock_board_columns">
        <a class="dropdown-item" data-action="unlock_board_columns" data-id="{{id}}">{{#pix}} t/unlock, core, {{#str}} unlockboardcolumns, mod_kanban {{/str}} {{/pix}}{{#str}} unlockboardcolumns, mod_kanban {{/str}}</a>
    </li>
    {{/manageboard}}
    {{^boardmode}}
    <li class="nav-item mod_kanban_show_board">
        <a class="dropdown-item" href="view.php?id={{cmid}}&group=0&user=0">{{#pix}} t/left, core, {{#str}} showboard, mod_kanban {{/str}} {{/pix}}{{#str}} showboard, mod_kanban {{/str}}</a>
    </li>
    {{/boardmode}}
    <li class="nav-item mod_kanban_delete_board">
        <a class="dropdown-item text-danger" data-action="delete_board" data-id="{{id}}">{{#pix}} t/delete, core, {{#str}} deleteboard, mod_kanban {{/str}} {{/pix}}{{#str}} deleteboard, mod_kanban {{/str}}</a>
    </li>
    {{#groupmode}}
    {{#groupselector}}
    <li class="nav-item mod_kanban_select_group">
        <a class="dropdown-item" data-bs-toggle="modal" data-toggle="modal" data-bs-target="#mod_kanban_change_group" data-target="#mod_kanban_change_group">{{#pix}} i/group, core, {{#str}} changegroup, mod_kanban {{/str}} {{/pix}}{{#str}} changegroup, mod_kanban {{/str}}</a>
    </li>
    {{/groupselector}}
    {{/groupmode}}
    {{#userboards}}
    {{^ismyuserboard}}
    <li class="nav-item mod_kanban_to_personal_board">
        <a class="dropdown-item" href="view.php?id={{cmid}}&group=0&user={{myuserid}}">{{#pix}} t/right, core, {{#str}} myuserboard, mod_kanban {{/str}} {{/pix}}{{#str}} myuserboard, mod_kanban {{/str}}</a>
    </li>
    {{/ismyuserboard}}
    {{#viewallboards}}
    <li class="nav-item mod_kanban_select_user">
        <a class="dropdown-item" data-bs-toggle="modal" data-toggle="modal" data-bs-target="#mod_kanban_change_user" data-target="#mod_kanban_change_user">{{#pix}} t/user, core, {{#str}} changeuser, mod_kanban {{/str}} {{/pix}}{{#str}} changeuser, mod_kanban {{/str}}</a>
    </li>
    {{/viewallboards}}
    {{/userboards}}
</ul>
{{/showactionmenu}}
{{#groupselector}}
<div class="modal fade" id="mod_kanban_change_group" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{#str}} changegroup, mod_kanban {{/str}}</h5>
                <button type="button" class="btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="{{#str}} closebuttontitle, core {{/str}}"></button>
            </div>
            <div class="modal-body">
                {{{groupselector}}}
            </div>
        </div>
    </div>
</div>
{{/groupselector}}
{{#userboards}}
    {{#viewallboards}}
    <div class="modal fade" id="mod_kanban_change_user" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{#str}} changeuser, mod_kanban {{/str}}</h5>
                    <button type="button" class="btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="{{#str}} closebuttontitle, core {{/str}}"></button>
                </div>
                <div class="modal-body">
                    {{>mod_kanban/singleuserselect}}
                </div>
            </div>
        </div>
    </div>
    {{/viewallboards}}
{{/userboards}}
{{#js}}
{{#groupselector}}
let gs = document.querySelector('#mod_kanban_change_group form');
if (gs) {
    gs.addEventListener('change', (e) => {
        e.target.closest('form').submit();
    });
}
{{/groupselector}}
{{#userboards}}
    {{#viewallboards}}
let us = document.querySelector('#mod_kanban_change_user form');
if (us) {
    us.addEventListener('change', (e) => {
        e.target.closest('form').submit();
    });
}
    {{/viewallboards}}
{{/userboards}}
{{/js}}
