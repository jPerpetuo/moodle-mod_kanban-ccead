{{!
    @template mod_kanban/card

    Template for a card in the kanban board.

    Example context (json):
    {
        "id": 4,
        "kanban_column": 1,
        "title": "Task",
        "hasassignees": false,
        "completed": true,
        "canedit": true,
        "duedate": 123456778,
        "number": 12
    }
}}
<li style="{{#background}}background-color: {{background}}{{/background}}" class="mod_kanban_card card{{#completed}} mod_kanban_closed{{/completed}} {{^hasassignees}}mod_kanban_unassigned{{/hasassignees}} {{#hasdescription}}mod_kanban_hasdescription{{/hasdescription}} {{#hasattachment}}mod_kanban_hasattachment{{/hasattachment}} {{#hasdiscussion}}mod_kanban_hasdiscussion{{/hasdiscussion}} {{#selfassigned}}mod_kanban_selfassigned{{/selfassigned}} {{#discussion}}mod_kanban_hasdiscussion{{/discussion}} {{#canedit}}mod_kanban_canedit{{/canedit}}" id="mod_kanban_card-{{id}}" data-id="{{id}}" data-columnid="{{kanban_column}}" data-number="{{number}}" data-completedat="{{completedat}}">
    <div class="card-body mod_kanban_card_body">
            <div class="mod_kanban_card_top">
            <div class="mod_kanban_card_title card-title">
                <span class="mod_kanban_card_number">#{{number}}</span>
                <span class="inplaceeditable inplaceeditable-text"{{#canedit}} {{^completed}}data-inplaceeditable="1" {{/completed}}data-component="mod_kanban" data-itemtype="card" data-itemid="{{id}}"
                data-value="{{{title}}}" data-type="text"{{/canedit}}>
                    <a class="quickeditlink aalink"{{#canedit}} data-inplaceeditablelink="1"{{/canedit}}>
                        {{{title}}}
                    </a>
                </span>
            </div>
            {{>mod_kanban/actionmenucard}}
        </div>
        <div class="mod_kanban_card_footer">
            <div class="mod_kanban_card_assignees_row{{#hasassignees}} has-assignees{{/hasassignees}}">
                <div class="mod_kanban_assignees" data-id="{{id}}" data-more-label="{{#str}} andmore, mod_kanban {{/str}}">
                    {{#hasassignees}}
                        {{#assignees}}
                            {{>mod_kanban/user}}
                        {{/assignees}}
                    {{/hasassignees}}
                </div>
            </div>
            <div class="mod_kanban_card_meta_row{{#completed}} has-meta{{/completed}}{{#duedate}} has-meta{{/duedate}}{{#hasdiscussion}} has-meta{{/hasdiscussion}}{{#discussion}} has-meta{{/discussion}}{{#hasdescription}} has-meta{{/hasdescription}}{{#hasattachment}} has-meta{{/hasattachment}}">
                <div class="mod_kanban_duedate" data-date="{{duedate}}"{{#duedate}} title="{{#str}} due, mod_kanban {{/str}}: {{#userdate}} {{duedate}}, {{#str}} strftimedate, core_langconfig {{/str}} {{/userdate}}"{{/duedate}}>
                    {{#duedate}}
                        <span class="mod_kanban_duedate_icon"><i class="icon fa-regular fa-calendar-days fa-fw" aria-hidden="true"></i></span>
                        <span class="mod_kanban_duedate_text">{{#userdate}} {{duedate}}, {{#str}} strftimedate, core_langconfig {{/str}} {{/userdate}}</span>
                    {{/duedate}}
                </div>
                <div class="mod_kanban_description">
                    <button class="mod_kanban_discussion_trigger btn btn-icon icon-no-margin p-0" data-bs-toggle="modal" data-toggle="modal" data-bs-target="#mod_kanban_discussion_modal_{{id}}" data-target="#mod_kanban_discussion_modal_{{id}}">
                    {{#pix}} t/messages, core, {{#str}} showdiscussion, mod_kanban {{/str}} {{/pix}}
                    </button>
                    <button class="mod_kanban_detail_trigger btn btn-icon icon-no-margin p-0">
                    {{#pix}} e/file-text, core, {{#str}} showdescription, mod_kanban {{/str}} {{/pix}}
                    </button>
                    <span class="mod_kanban_card_completion_indicator" title="{{#str}} completed, core {{/str}}" data-completed-label="{{#str}} completedon, mod_kanban {{/str}}" data-completed-fallback="{{#str}} completed, core {{/str}}" data-planned-label="{{#str}} plannedfor, mod_kanban {{/str}}">
                        <i class="fa fa-check fa-fw" aria-hidden="true"></i>
                    </span>
                </div>
            </div>
            <div class="mod_kanban_tags">
            </div>
        </div>
        {{>mod_kanban/discussionmodal}}
        {{>mod_kanban/historymodal}}
    </div>
    {{>mod_kanban/addcard}}
</li>

{{#js}}
require(['core/inplace_editable']);
require(['mod_kanban/card'], function(component) {
    component.init('mod_kanban_card-{{id}}');
});
require(['core/ajax', 'core/notification'], function(Ajax, Notification) {
    const card = document.getElementById('mod_kanban_card-{{id}}');
    if (!card) {
        return;
    }

    const inplace = card.querySelector('.mod_kanban_card_title .inplaceeditable');
    const editlink = inplace ? inplace.querySelector('[data-inplaceeditablelink]') : null;
    if (!inplace || !editlink) {
        return;
    }

    let issaving = false;
    card.__modKanbanTitleSaveSeq = card.__modKanbanTitleSaveSeq || 0;

    const decodeHtmlEntities = function(value) {
        const textarea = document.createElement('textarea');
        textarea.innerHTML = value || '';
        return textarea.value;
    };

    const renderTitle = function(displayvalue) {
        const safevalue = displayvalue || '';
        inplace.setAttribute('data-value', decodeHtmlEntities(safevalue));
        inplace.innerHTML = '<a class="quickeditlink aalink" data-inplaceeditablelink="1">' + safevalue + '</a>';
        const discussiontitle = card.querySelector('.mod_kanban_discussion_modal .modal-title');
        if (discussiontitle) {
            discussiontitle.textContent = decodeHtmlEntities(safevalue);
        }
    };

    const closeEditor = function(displayvalue, focuslink = true) {
        renderTitle(displayvalue);
        inplace.classList.remove('inplaceeditingon');
        card.setAttribute('draggable', 'true');
        card.removeAttribute('data-inplace-in-draggable');
        if (focuslink) {
            const refreshedlink = inplace.querySelector('[data-inplaceeditablelink]');
            if (refreshedlink) {
                refreshedlink.focus();
            }
        }
    };

    const markTitlePending = function(expectedplainvalue) {
        card.__modKanbanTitleSaveSeq += 1;
        const seq = card.__modKanbanTitleSaveSeq;
        const lockvalue = expectedplainvalue || '';
        card.dataset.titleSavePending = '1';
        card.dataset.titleSaveExpected = lockvalue;
        card.dataset.titleSaveSeq = String(seq);
        card.dataset.titleLockValue = lockvalue;
        card.dataset.titleLockUntil = String(Date.now() + 2000);
        return seq;
    };

    const clearTitlePending = function(seq = null) {
        if (seq !== null) {
            const currentseq = card.dataset.titleSaveSeq || '';
            if (currentseq !== String(seq)) {
                return;
            }
        }
        delete card.dataset.titleSavePending;
        delete card.dataset.titleSaveExpected;
        delete card.dataset.titleSaveSeq;
    };

    const saveTitle = function(newvalue, saveseq = null) {
        if (issaving) {
            return;
        }
        issaving = true;
        Ajax.call([{
            methodname: 'core_update_inplace_editable',
            args: {
                component: 'mod_kanban',
                itemtype: 'card',
                itemid: '{{id}}',
                value: newvalue,
            },
        }])[0].then((data) => {
            const displayvalue = data.displayvalue !== undefined ? data.displayvalue : newvalue;
            const plainconfirmed = decodeHtmlEntities(displayvalue);
            renderTitle(displayvalue);
            card.dataset.titleLockValue = plainconfirmed;
            card.dataset.titleLockUntil = String(Date.now() + 2000);
            clearTitlePending(saveseq);
            issaving = false;
            return;
        }).fail((error) => {
            Notification.exception(error);
            clearTitlePending(saveseq);
            delete card.dataset.titleLockValue;
            delete card.dataset.titleLockUntil;
            issaving = false;
        });
    };

    inplace.addEventListener('click', function(e) {
        const clickedlink = e.target.closest('[data-inplaceeditablelink]');
        if (!clickedlink) {
            return;
        }
        if (!inplace.hasAttribute('data-inplaceeditable') || inplace.classList.contains('inplaceeditingon') || issaving) {
            return;
        }

        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        const currentvalue = decodeHtmlEntities(inplace.getAttribute('data-value') || clickedlink.textContent || '');
        inplace.classList.add('inplaceeditingon');
        card.setAttribute('draggable', 'false');
        card.setAttribute('data-inplace-in-draggable', 'true');

        const textarea = document.createElement('textarea');
        textarea.className = 'form-control ignoredirty mod_kanban_card_title_editor';
        textarea.rows = 4;
        textarea.value = currentvalue;
        textarea.setAttribute('aria-label', 'Editar titulo do cartao');

        inplace.innerHTML = '';
        inplace.appendChild(textarea);

        textarea.focus();
        textarea.selectionStart = textarea.value.length;
        textarea.selectionEnd = textarea.value.length;

        let handled = false;
        let outsideClickHandler = null;
        let outsideTouchHandler = null;
        const detachOutsideHandlers = function() {
            if (outsideClickHandler) {
                document.removeEventListener('mousedown', outsideClickHandler, true);
                outsideClickHandler = null;
            }
            if (outsideTouchHandler) {
                document.removeEventListener('touchstart', outsideTouchHandler, true);
                outsideTouchHandler = null;
            }
        };
        const commit = function() {
            if (handled) {
                return;
            }
            handled = true;
            detachOutsideHandlers();
            const savedvalue = textarea.value.trim() === '' ? '{{#str}} newcard, mod_kanban {{/str}}' : textarea.value;
            const saveseq = markTitlePending(savedvalue);
            closeEditor(savedvalue, true);
            saveTitle(savedvalue, saveseq);
        };
        const cancel = function() {
            if (handled) {
                return;
            }
            handled = true;
            detachOutsideHandlers();
            closeEditor(currentvalue, true);
        };

        textarea.addEventListener('keydown', function(evt) {
            const key = evt.key || '';
            const isescape = key === 'Escape' || key === 'Esc' || evt.keyCode === 27;
            const isenter = key === 'Enter' || evt.keyCode === 13;

            if (isescape) {
                evt.preventDefault();
                cancel();
                return;
            }
            if (isenter && !evt.shiftKey) {
                evt.preventDefault();
                commit();
            }
        });

        textarea.addEventListener('blur', function() {
            commit();
        });

        outsideClickHandler = function(evt) {
            if (!inplace.contains(evt.target)) {
                commit();
            }
        };
        outsideTouchHandler = function(evt) {
            if (!inplace.contains(evt.target)) {
                commit();
            }
        };
        document.addEventListener('mousedown', outsideClickHandler, true);
        document.addEventListener('touchstart', outsideTouchHandler, true);
    });
});

require([], function() {
    const card = document.getElementById('mod_kanban_card-{{id}}');
    if (!card) {
        return;
    }

    const summaryclass = 'mod_kanban_assignee_summary';
    const hiddenclass = 'mod_kanban_assigned_user_hidden';
    const readyclass = 'mod_kanban_assignees_enhanced';

    const renderSummary = function() {
        const container = card.querySelector('.mod_kanban_assignees');
        if (!container || container.__modKanbanSummaryRendering) {
            return;
        }
        container.__modKanbanSummaryRendering = true;

        try {
            container.classList.remove(readyclass);
            container.querySelectorAll('.' + summaryclass).forEach(function(node) {
                node.remove();
            });

            const assignees = Array.from(container.querySelectorAll('.mod_kanban_assigned_user')).filter(function(node) {
                return !node.classList.contains(summaryclass);
            });
            card.classList.toggle('mod_kanban_assignees_multi', assignees.length > 1);
            card.classList.toggle('mod_kanban_assignees_has_summary', assignees.length > 2);
            assignees.forEach(function(node) {
                node.classList.remove(hiddenclass);
            });

            if (assignees.length > 2) {
                const hidden = assignees.slice(2);
                hidden.forEach(function(node) {
                    node.classList.add(hiddenclass);
                });

                const hiddennames = hidden.map(function(node) {
                    return (node.getAttribute('title') || '').trim();
                }).filter(function(name) {
                    return name.length > 0;
                });

                const rawlabel = (container.dataset.moreLabel || '').trim();
                const morelabel = (!rawlabel || rawlabel.startsWith('[[') || rawlabel.toLowerCase() === 'and more') ? 'e mais' : rawlabel;

                const summary = document.createElement('div');
                summary.className = 'mod_kanban_assigned_user ' + summaryclass;
                summary.setAttribute('tabindex', '0');

                if (hiddennames.length > 0) {
                    summary.setAttribute('title', hiddennames.join('\n'));
                }

                const icon = document.createElement('span');
                icon.className = 'mod_kanban_assigned_user_icon';
                icon.innerHTML = '<i class="icon fa fa-user fa-fw" aria-hidden="true"></i>';

                const text = document.createElement('span');
                text.className = 'mod_kanban_assigned_user_name';
                text.textContent = morelabel + ' ' + hidden.length;

                summary.appendChild(icon);
                summary.appendChild(text);
                container.appendChild(summary);
            }
        } finally {
            container.classList.add(readyclass);
            container.__modKanbanSummaryRendering = false;
        }
    };

    const scheduleRender = function() {
        if (card.__modKanbanAssigneeSummaryTimer) {
            clearTimeout(card.__modKanbanAssigneeSummaryTimer);
        }
        card.__modKanbanAssigneeSummaryTimer = setTimeout(renderSummary, 0);
    };

    renderSummary();
    const assigneecontainer = card.querySelector('.mod_kanban_assignees');
    if (assigneecontainer) {
        const observer = new MutationObserver(function() {
            scheduleRender();
        });
        observer.observe(assigneecontainer, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['class', 'title']
        });
        card.__modKanbanAssigneeSummaryObserver = observer;
    }
});
{{/js}}

