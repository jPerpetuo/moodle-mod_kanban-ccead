{{!
    @template mod_kanban/boardselector

    Dropdown selector for teachers to switch between boards.

    Example context (json):
    {
        "show": true,
        "label": "Current board",
        "currentlabel": "Group A",
        "summary": "You are viewing 1 of 4 boards",
        "groupmemberslabel": "4 members in this group",
        "boards": [
            {
                "id": 4,
                "label": "Group A",
                "icon": "i/group",
                "url": "view.php?id=12&groupid=4",
                "current": true
            }
        ]
    }
}}
{{#boardselector.show}}
<div class="dropdown mod_kanban_boardselector">
    <button class="btn btn-outline-secondary dropdown-toggle mod_kanban_boardselector_button"
            type="button"
            data-bs-toggle="dropdown"
            data-toggle="dropdown"
            aria-expanded="false"
            title="{{boardselector.label}}"
            aria-label="{{boardselector.label}}">
        <span class="mod_kanban_boardselector_icon">{{#pix}} i/group, core, {{boardselector.label}} {{/pix}}</span>
        <span class="mod_kanban_boardselector_current">{{boardselector.shortcurrentlabel}}</span>
    </button>
    <ul class="dropdown-menu mod_kanban_boardselector_menu">
        {{#boardselector.boards}}
            <li>
                <a class="dropdown-item{{#current}} mod_kanban_boardselector_item_current{{/current}}"
                   href="{{url}}">
                    {{label}}
                </a>
            </li>
        {{/boardselector.boards}}
    </ul>
</div>
{{/boardselector.show}}
